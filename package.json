{
  "name": "dictuzz.github.io",
  "version": "2.1.0",
  "private": true,
  "description": "Personal portfolio & resume \u2014 dictuzz.me",
  "type": "module",
  "scripts": {
    "dev": "npx -y serve . -l 8000 --no-clipboard",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.js",
    "build:icons": "node scripts/build-icons.mjs",
    "build:search-index": "node scripts/build-search-index.mjs",
    "test:a11y": "npx axe http://localhost:8000 --tags wcag2aa,wcag21aa --save results/axe-report.json --exit",
    "test:a11y:ci": "lhci autorun",
    "serve:ci": "npx serve . -l 8000",
    "update:fmhy": "node scripts/update-fmhy.mjs && npm run build:search-index"
  },
  "author": "Benedictus Richard Ricardo",
  "license": "UNLICENSED",
  "devDependencies": {
    "@axe-core/cli": "^4.11.3",
    "@iconify-json/carbon": "^1.2.22",
    "@iconify-json/fluent": "^1.2.48",
    "@iconify-json/twemoji": "^1.2.5",
    "axe-core": "^4.12.1",
    "happy-dom": "^20.8.4"
  },
  "dependencies": {
    "@iconify-json/gravity-ui": "^1.2.12",
    "@iconify-json/ph": "^1.2.2"
  }
}
