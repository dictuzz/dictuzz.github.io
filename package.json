{
  "name": "dictuzz.github.io",
  "version": "2.1.0",
  "private": true,
  "description": "Personal portfolio & resume — dictuzz.me",
  "type": "module",
  "scripts": {
    "dev": "npx -y serve . -l 8000 --no-clipboard",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.js",
    "build:icons": "node scripts/build-icons.mjs",
    "build:search-index": "node scripts/build-search-index.mjs",
    "test:a11y": "axe-cli http://localhost:8000 --tags wcag2aa,wcag21aa --save results/axe-report.json --exit",
    "test:a11y:ci": "lighthouse http://localhost:8000 --only-categories=accessibility --output=json --output-path=results/lighthouse-a11y.json --chrome-flags='--headless --no-sandbox' --budget-path=.lighthouse-budget.json",
    "serve:ci": "npx serve . -l 8000"
  },
  "author": "Benedictus Richard Ricardo",
  "license": "UNLICENSED",
  "devDependencies": {
    "@axe-core/cli": "^4.11.3",
    "@iconify-json/carbon": "^1.2.22",
    "@iconify-json/fluent": "^1.2.48",
    "@iconify-json/fluent-mdl2": "^1.2.1",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/qlementine-icons": "^1.2.15",
    "@iconify-json/simple-icons": "^1.2.84",
    "@iconify-json/twemoji": "^1.2.5",
    "@unocss/preset-icons": "^66.7.0",
    "axe-core": "^4.12.1",
    "happy-dom": "^20.8.4",
    "unocss": "^66.7.0"
  },
  "dependencies": {
    "@iconify-json/gravity-ui": "^1.2.12",
    "@iconify-json/lucide": "^1.2.111",
    "@iconify-json/ph": "^1.2.2",
    "@iconify/json": "^2.2.482"
  }
}
