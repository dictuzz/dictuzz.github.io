{
  "name": "dictuzz-portfolio-app",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "protect": "node scripts/generate-protected-content.mjs",
    "copy-tokens": "node -e \"require('fs').copyFileSync('../assets/css/tokens.css', 'styles/tokens.css')\"",
    "dev": "npm run copy-tokens && next dev",
    "build": "npm run copy-tokens && npm run protect && next build",
    "typecheck": "tsc --noEmit",
    "publish": "node scripts/publish.mjs",
    "build:publish": "npm run build && npm run publish"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "^5.9.3"
  }
}
