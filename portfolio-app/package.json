{
  "name": "dictuzz-portfolio-app",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "protect": "node scripts/generate-protected-content.mjs",
    "sync-content": "node scripts/sync-content.mjs",
    "dev": "npm run sync-content && next dev",
    "build": "npm run sync-content && npm run protect && next build",
    "test": "npm run sync-content && tsx --test lib/*.test.ts data/*.test.ts",
    "typecheck": "npm run sync-content && tsc --noEmit",
    "publish": "node scripts/publish.mjs",
    "build:publish": "npm run build && npm run publish"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "^5.9.3"
  }
}
