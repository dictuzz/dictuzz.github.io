{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[legacySlug]/layout,_N_T_/[legacySlug]/page,_N_T_/signal-room-live-experience/"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$legacySlug/__PAGE__",
    "/$d$legacySlug",
    "/_index",
    "/_head"
  ]
}